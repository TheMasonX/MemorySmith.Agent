{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Agent: quick build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "MemorySmith.Agent.slnx", "--configuration", "Debug", "-p:CopilotSkipCliDownload=true"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Agent: quick tests",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "MemorySmith.Agent.Tests/MemorySmith.Agent.Tests.csproj", "--no-restore", "--configuration", "Debug", "--filter", "FullyQualifiedName~Sprint39|FullyQualifiedName~ActionOutcome"],
      "problemMatcher": "$msCompile",
      "group": "test",
      "dependsOn": "Agent: quick build"
    }
  ]
}